# Frontend (Vercel Environment Variable)
# Set to your deployed Node.js + Socket.IO backend URL (e.g. from Render, Railway, or Fly.io)
# Leave empty during local dev (Vite proxies /socket.io to http://localhost:3001).
VITE_SERVER_URL=
VITE_DOD_CHIP_ADDRESS=
VITE_DOD_ARENA_ADDRESS=
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Sepolia Smart Contract Deployment (@doodle-dash/contracts)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Backend Server (@doodle-dash/server)
PORT=3001
# Comma-separated allowed origins (e.g. https://dodsnakes.vercel.app) or * for any origin
CORS_ORIGIN=https://dodsnakes.vercel.app
