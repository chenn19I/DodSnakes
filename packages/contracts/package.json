{
  "name": "@doodle-dash/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Confidential FHEVM smart contracts and Sepolia testnet suite for DodSnakes",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:fhe": "hardhat test",
    "node": "hardhat node",
    "wallets:gen": "hardhat run scripts/generateTestnetWallets.ts",
    "export:abis": "ts-node scripts/exportClientArtifacts.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/smokeSepolia.ts --network sepolia",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "^4.5.0",
    "dotenv": "^16.5.0",
    "encrypted-types": "^0.0.4",
    "ethers": "^6.16.0",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
